---
import '../styles/diagram.css';
import type { DNode, DLink, DInfo, DFlow } from '../data/argocd-diagram';

interface Box { x: number; y: number; w: number; h: number; label: string }
interface Props { nodes: DNode[]; links: DLink[]; info: Record<string, DInfo>; flows: DFlow[]; boxes?: Box[]; viewBox?: string; label?: string }
const { nodes: NODES, links: LINKS, info: INFO, flows: FLOWS, boxes = [], viewBox = '0 0 1280 720', label = 'Architecture diagram' } = Astro.props;
---
    <div class="ad-controls reveal" style="--i:4">
      <div class="ad-tabs" role="tablist" aria-label="Request flows" id="adTabs">
        {FLOWS.map((f, i) => (
          <button class="ad-tab" role="tab" data-flow={i} aria-selected={i === 0 ? 'true' : 'false'} title={f.blurb}>{f.label}</button>
        ))}
      </div>
      <div class="ad-btns">
        <button class="ad-btn" id="adPrev" aria-label="Previous step"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
        <button class="ad-btn" id="adPlay" aria-label="Pause"><svg id="adPlayIco" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></button>
        <button class="ad-btn" id="adNext" aria-label="Next step"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>

    <div class="ad-caption reveal" style="--i:5" id="adCaption" aria-live="polite">
      <div class="ad-cap-top"><span class="ad-step-n" id="adN"></span><span class="ad-step-t" id="adT"></span></div>
      <p class="ad-step-p" id="adP"></p>
      <div class="ad-dots" id="adDots"></div>
      <div class="ad-bar" id="adBar"></div>
    </div>

    <div class="ad-stage reveal" style="--i:6" id="adStage">
      <div class="ad-canvas">
        <svg id="adSvg" viewBox={viewBox} role="group" aria-label={label}>
          {boxes.map((bx) => (
            <>
              <rect class="ad-box" x={bx.x} y={bx.y} width={bx.w} height={bx.h} rx="30" />
              <text class="ad-box-label" x={bx.x + 28} y={bx.y + 32}>{bx.label}</text>
            </>
          ))}

          {LINKS.map((l) => (
            <g class:list={['ad-link', { dashed: l.dashed }]} data-id={l.id}>
              <path id={`lk-${l.id}`} d={l.d} />
              <text class="ad-lbl" x={l.lx} y={l.ly} text-anchor={l.anchor ?? 'middle'}>{l.label}</text>
            </g>
          ))}

          <g id="adPackets"></g>

          {NODES.map((n) => {
            const cx = n.x + n.w / 2;
            const cy = n.y + n.h / 2;
            return (
              <g class:list={['ad-node', n.kind]} data-id={n.id} tabindex="0" role="button" aria-label={`${INFO[n.id].name}: ${INFO[n.id].tag}`}>
                <rect class="body" x={n.x} y={n.y} width={n.w} height={n.h} rx={n.kind === 'ext' ? 22 : 16} />
                {n.kind === 'comp' && <circle class="dot" cx={n.x + n.w - 16} cy={n.y + 16} r="3.5" />}
                {n.lines ? (
                  <>
                    {n.lines.map((ln, i) => <text class="t" x={cx} y={cy - (n.lines.length - 1) * 12 - (n.sublines?.length ?? 0) * 8 + 5 + i * 24} text-anchor="middle">{ln}</text>)}
                    {(n.sublines ?? []).map((sl, j) => <text class="s" x={cx} y={cy - (n.lines.length - 1) * 12 - (n.sublines?.length ?? 0) * 8 + 5 + (n.lines.length - 1) * 24 + 22 + j * 16} text-anchor="middle">{sl}</text>)}
                  </>
                ) : (
                  <>
                    <text class="t" x={cx} y={cy - 2} text-anchor="middle">{n.title}</text>
                    <text class="s" x={cx} y={cy + 20} text-anchor="middle">{n.sub}</text>
                  </>
                )}
              </g>
            );
          })}
        </svg>
      </div>
      <div class="ad-pop" id="adPop" role="tooltip"></div>
      <p class="ad-hint" id="adHint">Hover or tap a component</p>
    </div>


  <script is:inline define:vars={{ INFO, FLOWS, LINKS }}>
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var NS = 'http://www.w3.org/2000/svg';
      var svg = document.getElementById('adSvg');
      var stage = document.getElementById('adStage');
      var pop = document.getElementById('adPop');
      var hint = document.getElementById('adHint');
      var pk = document.getElementById('adPackets');
      var nodeEls = {}, linkEls = {}, paths = {};
      svg.querySelectorAll('.ad-node').forEach(function (g) { nodeEls[g.dataset.id] = g; });
      svg.querySelectorAll('.ad-link').forEach(function (g) { linkEls[g.dataset.id] = g; });
      LINKS.forEach(function (l) { var p = document.getElementById('lk-' + l.id); paths[l.id] = { el: p, len: p.getTotalLength() }; });
      var linkById = {}; LINKS.forEach(function (l) { linkById[l.id] = l; });
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };

      function circle(cls, r) { var c = document.createElementNS(NS, 'circle'); c.setAttribute('r', r); c.setAttribute('class', cls); pk.appendChild(c); return c; }

      // ambient traffic on every link
      var ambient = [];
      if (!reduce) LINKS.forEach(function (l, i) {
        [0, 0.5].forEach(function (ph, k) {
          ambient.push({ el: circle('ad-pkt amb', 2.2), id: l.id, phase: (ph + i * 0.13) % 1, rev: l.bi && k === 1, speed: 60 + (i % 4) * 8 });
        });
      });

      // state
      var f = 0, s = 0, playing = !reduce, hoverId = null, stepStart = performance.now(), timer = null, visible = false, tickStart = 0;
      var DUR = 4600, act = [];

      function setAct(list) {
        act.forEach(function (a) { a.el.remove(); });
        act = [];
        if (reduce) return;
        list.forEach(function (it) {
          for (var k = 0; k < 3; k++) act.push({ el: circle('ad-pkt act', 4 - k * 0.7), id: it.id, dir: it.dir, k: k });
        });
      }

      function neighbors(id) {
        var ns = new Set([id]), ls = [];
        LINKS.forEach(function (l) {
          if (l.from === id) { ns.add(l.to); ls.push({ id: l.id, dir: 1 }); }
          else if (l.to === id) { ns.add(l.from); ls.push({ id: l.id, dir: -1 }); }
        });
        return { nodes: ns, links: ls };
      }

      function paint() {
        var step = FLOWS[f].steps[s];
        var an, al, packets;
        if (hoverId) {
          var n = neighbors(hoverId); an = n.nodes; al = n.links; packets = n.links;
        } else {
          an = new Set(step.nodes);
          al = step.link ? [{ id: step.link, dir: step.dir == null ? 1 : step.dir }] : [];
          packets = al;
        }
        var alIds = new Set(al.map(function (x) { return x.id; }));
        svg.classList.add('focus');
        Object.keys(nodeEls).forEach(function (id) {
          nodeEls[id].classList.toggle('active', an.has(id));
          nodeEls[id].classList.toggle('pulse', !hoverId && step.pulse === id);
        });
        Object.keys(linkEls).forEach(function (id) { linkEls[id].classList.toggle('active', alIds.has(id)); });
        setAct(packets);
        stepStart = performance.now();
      }

      var capN = document.getElementById('adN'), capT = document.getElementById('adT'), capP = document.getElementById('adP');
      var cap = document.getElementById('adCaption'), dots = document.getElementById('adDots'), bar = document.getElementById('adBar');
      function caption() {
        var fl = FLOWS[f], st = fl.steps[s];
        capN.textContent = 'Step ' + (s + 1) + ' of ' + fl.steps.length;
        capT.textContent = st.title;
        capP.textContent = st.text;
        cap.classList.remove('ad-cap-swap'); void cap.offsetWidth; cap.classList.add('ad-cap-swap');
        dots.innerHTML = '';
        fl.steps.forEach(function (_, i) {
          var b = document.createElement('button');
          b.setAttribute('aria-label', 'Go to step ' + (i + 1));
          if (i === s) b.setAttribute('aria-current', 'step');
          b.addEventListener('click', function () { go(i, true); });
          dots.appendChild(b);
        });
      }

      function go(i, user) {
        var n = FLOWS[f].steps.length;
        s = (i + n) % n;
        if (user) { setPlaying(false); }
        caption(); paint(); tickStart = performance.now();
      }
      function pickFlow(i) {
        f = i; s = 0;
        document.querySelectorAll('.ad-tab').forEach(function (t, k) { t.setAttribute('aria-selected', k === i ? 'true' : 'false'); });
        caption(); paint(); tickStart = performance.now();
      }

      var playIco = document.getElementById('adPlayIco'), playBtn = document.getElementById('adPlay');
      function setPlaying(v) {
        playing = v && !reduce;
        playBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
        playIco.innerHTML = playing
          ? '<rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>'
          : '<path d="M7 4.5v15a1 1 0 0 0 1.5.86l12-7.5a1 1 0 0 0 0-1.72l-12-7.5A1 1 0 0 0 7 4.5z"/>';
        tickStart = performance.now();
        if (!playing) bar.style.width = '0';
      }

      document.getElementById('adTabs').addEventListener('click', function (e) {
        var b = e.target.closest('.ad-tab'); if (b) pickFlow(+b.dataset.flow);
      });
      document.getElementById('adPrev').addEventListener('click', function () { go(s - 1, true); });
      document.getElementById('adNext').addEventListener('click', function () { go(s + 1, true); });
      playBtn.addEventListener('click', function () { setPlaying(!playing); });

      // popover
      var hideT = null;
      function showPop(id) {
        clearTimeout(hideT);
        var i = INFO[id];
        pop.innerHTML = '<div class="k">' + esc(i.tag) + '</div><h4>' + esc(i.name) + '</h4><p>' + esc(i.does) + '</p>' +
          '<div class="k">Request flow</div><ul>' + i.flow.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>' +
          '<div class="k">Talks to</div><div class="tk">' + i.talks.map(function (t) { return '<span>' + esc(t) + '</span>'; }).join('') + '</div>';
        var sr = stage.getBoundingClientRect(), nr = nodeEls[id].getBoundingClientRect();
        var pw = pop.offsetWidth || 340, ph = pop.offsetHeight || 300, g = 16;
        var nb = neighbors(id).nodes;
        function rel(r) { return { l: r.left - sr.left, t: r.top - sr.top, r: r.right - sr.left, b: r.bottom - sr.top }; }
        var me = rel(nr);
        var others = Object.keys(nodeEls).map(function (k) { return { id: k, r: rel(nodeEls[k].getBoundingClientRect()) }; });
        function clampX(x) { return Math.max(10, Math.min(sr.width - pw - 10, x)); }
        function clampY(y) { return Math.max(10, Math.min(sr.height - ph - 10, y)); }
        var cx = (me.l + me.r) / 2 - pw / 2, cy = (me.t + me.b) / 2 - ph / 2;
        var cands = [
          { l: me.r + g, t: clampY(cy) }, { l: me.l - pw - g, t: clampY(cy) },
          { l: clampX(cx), t: me.b + g }, { l: clampX(cx), t: me.t - ph - g },
          { l: 10, t: 10 }, { l: sr.width - pw - 10, t: 10 }, { l: 10, t: sr.height - ph - 10 }, { l: sr.width - pw - 10, t: sr.height - ph - 10 }
        ];
        function ov(a, r) { var w = Math.min(a.l + pw, r.r) - Math.max(a.l, r.l), h = Math.min(a.t + ph, r.b) - Math.max(a.t, r.t); return w > 0 && h > 0 ? w * h : 0; }
        var best = null, bestScore = Infinity;
        cands.forEach(function (c) {
          var out = (c.l < 4 || c.t < 4 || c.l + pw > sr.width - 4 || c.t + ph > sr.height - 4) ? 1e9 : 0;
          var score = out;
          others.forEach(function (o) { score += ov(c, o.r) * (o.id === id ? 6 : nb.has(o.id) ? 4 : 1); });
          if (score < bestScore) { bestScore = score; best = c; }
        });
        pop.style.left = best.l + 'px'; pop.style.top = best.t + 'px';
        pop.classList.add('show'); hint.classList.add('gone');
      }
      function hidePop() { pop.classList.remove('show'); }
      function enter(id) { hoverId = id; showPop(id); paint(); }
      function leave() { hoverId = null; hideT = setTimeout(hidePop, 120); paint(); }

      Object.keys(nodeEls).forEach(function (id) {
        var el = nodeEls[id];
        el.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') enter(id); });
        el.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') leave(); });
        el.addEventListener('focus', function () { enter(id); });
        el.addEventListener('blur', leave);
        el.addEventListener('click', function (e) { if (e.pointerType !== 'mouse' || e.detail === 0) enter(id); });
        el.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enter(id); } if (e.key === 'Escape') { el.blur(); } });
      });
      stage.addEventListener('click', function (e) { if (!e.target.closest('.ad-node')) leave(); });

      // animation loop
      var raf = 0;
      function frame(now) {
        var t = now / 1000;
        ambient.forEach(function (a) {
          var p = paths[a.id]; var u = ((t * a.speed) / p.len + a.phase) % 1; var d = a.rev ? 1 - u : u;
          var pt = p.el.getPointAtLength(d * p.len);
          a.el.setAttribute('cx', pt.x); a.el.setAttribute('cy', pt.y);
          a.el.style.opacity = (0.5 * Math.sin(Math.PI * u)).toFixed(3);
        });
        var CYC = 1500;
        act.forEach(function (a) {
          var p = paths[a.id]; var el = (now - stepStart) - a.k * 170;
          if (el < 0) { a.el.style.opacity = 0; return; }
          var u = (el % CYC) / CYC; var d;
          if (a.dir === 0) { d = u < 0.5 ? u * 2 : (1 - u) * 2; }
          else d = a.dir === -1 ? 1 - u : u;
          var pt = p.el.getPointAtLength(d * p.len);
          a.el.setAttribute('cx', pt.x); a.el.setAttribute('cy', pt.y);
          a.el.style.opacity = Math.min(1, Math.sin(Math.PI * u) * 1.6).toFixed(3);
        });
        if (playing && visible && !hoverId) {
          var el2 = now - tickStart;
          bar.style.width = Math.min(100, (el2 / DUR) * 100) + '%';
          if (el2 >= DUR) go(s + 1, false);
        } else if (playing) { tickStart = now - parseFloat(bar.style.width || 0) / 100 * DUR; }
        raf = requestAnimationFrame(frame);
      }

      new IntersectionObserver(function (es) {
        visible = es[0].isIntersecting;
        if (!reduce) { if (visible && !raf) raf = requestAnimationFrame(frame); else if (!visible) { cancelAnimationFrame(raf); raf = 0; } }
      }, { threshold: 0.25 }).observe(stage);
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) { cancelAnimationFrame(raf); raf = 0; } else if (visible && !reduce && !raf) raf = requestAnimationFrame(frame);
      });

      setPlaying(!reduce);
      pickFlow(0);
    })();
  </script>
