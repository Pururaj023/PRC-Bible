---
import Orb from './Orb.astro';
import { categories } from '../data/categories';
const { path } = Astro.props;
---
<header class="site-header">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="PRC home">
      <Orb size="26px" state="searching" />
      PRC
    </a>
    <nav class="links" aria-label="Sections">
      {categories.map((c) => (
        <a href={`/${c.slug}/`} aria-current={path.startsWith(`/${c.slug}/`) ? 'page' : undefined}>{c.nav}</a>
      ))}
    </nav>
  </div>
</header>
