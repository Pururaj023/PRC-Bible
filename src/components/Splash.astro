---
---
<div id="splash" role="presentation">
  <div class="sp-stage">
    <div class="orb-wrap sp-orb">
      <span class="ring"></span><span class="ring"></span><span class="ring"></span>
      <span class="o o1"><i></i></span>
      <span class="o o2"><i></i></span>
      <span class="o o3"><i></i></span>
      <div class="orb"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>
    </div>

    <div class="sp-think" aria-live="off">
      <span class="ph p1">Thinking<em class="dots"><i></i><i></i><i></i></em></span>
      <span class="ph p2">Gathering the playbooks</span>
      <span class="ph p3">Ready</span>
    </div>
  </div>
  <p class="sp-skip">Tap anywhere to skip</p>
</div>

<script is:inline>
  (function () {
    var done = false;
    function fin() { if (done) return; done = true; window.dispatchEvent(new Event('splash:done')); }
    var s = document.getElementById('splash');
    if (!s || document.documentElement.classList.contains('no-splash')) { fin(); return; }
    var t = setTimeout(fin, 3300);
    function skip() {
      clearTimeout(t);
      s.classList.add('skip');
      document.removeEventListener('keydown', skip);
      fin();
    }
    s.addEventListener('click', skip);
    s.addEventListener('touchstart', skip, { passive: true });
    document.addEventListener('keydown', skip);
  })();
</script>

<style is:global>
  #splash{
    position:fixed;inset:0;z-index:999;display:grid;place-items:center;cursor:pointer;
    background:
      radial-gradient(60vmax 60vmax at 50% 45%,rgba(255,255,255,.07),transparent 62%),
      #050505;
    animation:sp-exit .9s cubic-bezier(.7,0,.2,1) 3.2s forwards;
  }
  #splash.skip{animation:none;opacity:0;visibility:hidden;transition:opacity .5s ease,visibility 0s .5s}
  .no-splash #splash{display:none}

  .sp-stage{display:flex;flex-direction:column;align-items:center;gap:clamp(96px,14vh,124px)}
  .sp-orb{--s:clamp(120px,22vmin,168px);animation:sp-in 1.1s var(--ease) both,sp-orb-out .8s cubic-bezier(.6,0,.2,1) 3.05s forwards}
  @keyframes sp-in{from{opacity:0;transform:scale(.55);filter:blur(18px)}to{opacity:1;transform:none;filter:none}}
  @keyframes sp-orb-out{to{transform:scale(1.9);opacity:0;filter:blur(14px)}}

  .sp-think{position:relative;height:22px;width:min(320px,80vw);text-align:center;font-size:14px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.7)}
  .ph{position:absolute;inset:0;opacity:0;white-space:nowrap}
  .p1{animation:ph 1.3s var(--ease) .5s both}
  .p2{animation:ph 1.3s var(--ease) 1.5s both}
  .p3{animation:ph-last .9s var(--ease) 2.5s both;color:#fff}
  @keyframes ph{0%{opacity:0;transform:translateY(10px);filter:blur(6px)}22%,70%{opacity:1;transform:none;filter:none}100%{opacity:0;transform:translateY(-10px);filter:blur(6px)}}
  @keyframes ph-last{0%{opacity:0;transform:translateY(10px);filter:blur(6px)}100%{opacity:1;transform:none;filter:none}}
  .dots{font-style:normal;display:inline-flex;gap:3px;margin-left:6px;vertical-align:middle}
  .dots i{width:3px;height:3px;border-radius:50%;background:#fff;animation:dot 1s ease-in-out infinite}
  .dots i:nth-child(2){animation-delay:.15s}.dots i:nth-child(3){animation-delay:.3s}
  @keyframes dot{0%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}

  .sp-skip{position:absolute;bottom:34px;left:0;right:0;text-align:center;margin:0;font-size:11px;letter-spacing:.18em;text-transform:uppercase;
    color:rgba(255,255,255,.28);animation:fade-late .8s ease 1.2s both}
  @keyframes fade-late{from{opacity:0}}

  @keyframes sp-exit{to{opacity:0;visibility:hidden;pointer-events:none;filter:blur(12px)}}

  @media (prefers-reduced-motion:reduce){
    #splash{animation:sp-exit .4s linear 1.2s forwards}
    .sp-orb{animation:none!important}
    .p1,.p2{display:none}.p3{animation:none;opacity:1}
  }
</style>
