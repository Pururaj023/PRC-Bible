---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import GuideCard from '../components/GuideCard.astro';
import Orb from '../components/Orb.astro';
import { categories, getCategory } from '../data/categories';

const guides = await getCollection('guides');
const index = guides.map((g) => ({
  title: g.data.title,
  summary: g.data.summary,
  cat: getCategory(g.data.category).title,
  href: `/${g.data.category}/${g.id}/`,
}));
const count = (slug: string) => guides.filter((g) => g.data.category === slug).length;
const topics = ['Kubernetes', 'Argo CD', 'KEDA', 'Azure Event Hub', 'Kafka', 'AKS', 'ELK Stack', 'Nginx', 'Helm', 'GitHub Actions', 'HPA', 'Linux'];
---
<Base>
  <div class="wrap">
    <section class="hero">
      <div class="hero-orb" id="heroOrb" role="button" tabindex="0" aria-label="The orb of questionable wisdom. Click for advice.">
        <Orb state="searching" />
        <span class="pulse" aria-hidden="true"></span>
        <p class="orb-hint" id="orbHint">Click the orb</p>
        <figure class="orb-quote" id="orbQuote" aria-live="polite"></figure>
      </div>

      <p class="kicker reveal blur" style="--i:0"><span class="dot"></span> Living reference</p>
      <h1 class="reveal-title" aria-label="PRC"><span style="--i:1">P</span><span style="--i:2">R</span><span style="--i:3">C</span></h1>
      <p class="lede reveal blur" style="--i:4">
        One place for your
        <span class="rotator" aria-hidden="true"><span>playbooks</span><span>runbooks</span><span>commands</span><span>scripts</span></span>,
        kept sharp and one search away.
      </p>
      <div class="hero-actions reveal" style="--i:5">
        <a class="btn btn-primary" href="/how-to/">Browse guides
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a class="btn" href="/scripts/">Scripts</a>
      </div>
    </section>

    <div class="marquee reveal" aria-hidden="true">
      <div class="track">
        <span>{topics.map((t) => <span>{t}</span>)}</span>
        <span>{topics.map((t) => <span>{t}</span>)}</span>
      </div>
    </div>

    <div class="search reveal" id="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q" type="search" placeholder="Search every guide" autocomplete="off" aria-label="Search guides" />
      <kbd>/</kbd>
      <div class="results" id="results" hidden></div>
    </div>

    <section class="home-grid">
      <p class="section-head">Sections</p>
      <div class="grid">
        {categories.map((c, i) => (
          <GuideCard
            i={i}
            href={`/${c.slug}/`}
            index={String(i + 1).padStart(2, '0')}
            icon={c.icon}
            title={c.title}
            summary={c.blurb}
            tag={count(c.slug) ? `${count(c.slug)} ${count(c.slug) === 1 ? 'guide' : 'guides'}` : 'Coming soon'}
          />
        ))}
      </div>
    </section>
  </div>


  <script is:inline>
    (function () {
      var wrap = document.getElementById('heroOrb');
      if (!wrap) return;
      var quoteEl = document.getElementById('orbQuote');
      var hint = document.getElementById('orbHint');
      var pulse = wrap.querySelector('.pulse');
      var canvas = wrap.querySelector('canvas');
      var STATES = ['working', 'searching', 'solving', 'listening', 'connecting', 'weaving', 'composing', 'breathing', 'shaping'];
      var QUOTES = [
        "It works on my machine. Ship the machine.",
        "Nothing is more permanent than a temporary fix.",
        "Have you tried reading the logs? Neither have I.",
        "Friday deploys build character. Mostly regret.",
        "A backup is just a restore you haven't tested yet.",
        "kubectl delete is a lifestyle choice.",
        "Documentation is a love letter to your future self. Reply rate: low.",
        "The cluster isn't down. It's thinking very hard.",
        "Everything is fine. The dashboard is just green with envy.",
        "Restart it. If that fails, restart it harder.",
        "Fix it in prod, they said. It'll be fun, they said.",
        "YAML: because indentation deserves consequences.",
        "99.9% uptime still leaves nearly nine hours a year for excuses.",
        "That TODO from 2023 says hi.",
        "Autoscaling: because panicking manually is exhausting.",
        "A secret in Git is only secret until the next clone.",
        "Works in staging. Staging is a state of mind.",
        "Monitoring: finding out about outages before the customer tweets. Sometimes.",
        "Root cause: human. Fix: another human.",
        "Rollback isn't failure. It's a time machine with change approval.",
        "The best code is the code you didn't write. Yours is a close second.",
        "Don't panic. Panic is an unmanaged resource.",
        "Wisdom loading. Please insert coffee.",
        "Click me again. I have infinite patience and finite wisdom.",
        "Alerts at 3 a.m. are just the universe asking if you're still on call.",
        "It's not a bug, it's an undocumented feature with commitment issues."
      ];
      function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }
      var bag = [], last = '';
      function nextQuote() {
        if (!bag.length) { bag = shuffle(QUOTES.slice()); if (bag[bag.length - 1] === last && bag.length > 1) bag.unshift(bag.pop()); }
        last = bag.pop(); return last;
      }
      var current = 'searching';
      function nextState() {
        var pool = STATES.filter(function (s) { return s !== current; });
        current = pool[Math.floor(Math.random() * pool.length)]; return current;
      }
      function say(text) {
        quoteEl.innerHTML = '';
        var p = document.createElement('p');
        text.split(' ').forEach(function (w, i) {
          var s = document.createElement('span'); s.textContent = w; s.style.setProperty('--w', i);
          p.appendChild(s); p.appendChild(document.createTextNode(' '));
        });
        var who = document.createElement('figcaption'); who.textContent = '— the orb, unqualified';
        quoteEl.appendChild(p); quoteEl.appendChild(who);
        quoteEl.classList.remove('on'); void quoteEl.offsetWidth; quoteEl.classList.add('on');
      }
      function go() {
        hint.classList.add('gone');
        pulse.classList.remove('go'); wrap.classList.remove('pop'); void wrap.offsetWidth;
        pulse.classList.add('go'); wrap.classList.add('pop');
        var st = nextState();
        setTimeout(function () { if (canvas._orb) canvas._orb.setState(st); }, 160);
        say(nextQuote());
      }
      wrap.addEventListener('click', go);
      wrap.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
    })();
  </script>

  <script is:inline define:vars={{ index }}>
    const q = document.getElementById('q');
    const box = document.getElementById('results');
    let sel = -1;
    const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    function render() {
      const t = q.value.trim().toLowerCase();
      if (!t) { box.hidden = true; return; }
      const hits = index.filter((g) => (g.title + ' ' + g.summary + ' ' + g.cat).toLowerCase().includes(t)).slice(0, 6);
      box.innerHTML = hits.length
        ? hits.map((g) => `<a href="${g.href}"><b>${esc(g.title)}</b><span>${esc(g.cat)} — ${esc(g.summary)}</span></a>`).join('')
        : '<div class="none">Nothing matches that yet.</div>';
      box.hidden = false; sel = -1;
    }
    q.addEventListener('input', render);
    q.addEventListener('keydown', (e) => {
      const items = [...box.querySelectorAll('a')];
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!items.length) return;
        sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
        items.forEach((a, i) => a.classList.toggle('sel', i === sel));
      } else if (e.key === 'Enter' && items.length) {
        items[sel < 0 ? 0 : sel].click();
      } else if (e.key === 'Escape') { q.value = ''; box.hidden = true; q.blur(); }
    });
    document.addEventListener('click', (e) => { if (!document.getElementById('search').contains(e.target)) box.hidden = true; });
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== q && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); q.focus(); }
    });
  </script>
</Base>
