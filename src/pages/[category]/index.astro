---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Orb from '../../components/Orb.astro';
import GuideCard from '../../components/GuideCard.astro';
import { categories, getCategory } from '../../data/categories';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug } }));
}
const { category } = Astro.params;
const cat = getCategory(category!);
const guides = (await getCollection('guides'))
  .filter((g) => g.data.category === category)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title={cat.title} description={cat.desc}>
  <div class="wrap cat">
    <a class="back reveal" href="/">← Home</a>
    <div class="cat-head">
      <h1 class="reveal-title" aria-label={cat.title}>
        {cat.title.split(' ').map((w, i) => <><span style={`--i:${i + 1}`}>{w}</span>{' '}</>)}
      </h1>
      <p class="cat-desc reveal blur" style="--i:3">{cat.desc}</p>
      <span class="pill reveal" style="--i:4">{guides.length} {guides.length === 1 ? 'guide' : 'guides'}</span>
    </div>

    {guides.length ? (
      <div class="grid">
        {guides.map((g, i) => (
          <GuideCard
            i={i}
            href={`/${cat.slug}/${g.id}/`}
            index={String(i + 1).padStart(2, '0')}
            icon={g.data.icon}
            title={g.data.title}
            summary={g.data.summary}
            tag={g.data.tag}
          />
        ))}
      </div>
    ) : (
      <div class="empty reveal" style="--i:5">
        <Orb size="56px" state="breathing" />
        <strong>Nothing here yet</strong>
        Share a doc and it will appear as a card.
      </div>
    )}
  </div>
</Base>
